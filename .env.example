# Copy to .env.local for local development, or add it in Vercel → Project → Settings → Environment Variables.

# Your production URL, used for Open Graph links and robots.txt. Optional on Vercel.
NEXT_PUBLIC_SITE_URL=

# Contact form. Get a free key at https://resend.com → API Keys. Without it, the form opens
# the visitor's mail app instead of sending.
RESEND_API_KEY=
# Optional sender, e.g. "Portfolio <hello@yourdomain.com>" once your domain is verified in Resend.
CONTACT_FROM=
