# Copy to .env.local for local development, and add the same variables in Vercel → Project → Settings → Environment Variables.

# Free access key from https://web3forms.com (it is safe to expose in the browser).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Your production URL, used for Open Graph links and robots.txt. Optional on Vercel.
NEXT_PUBLIC_SITE_URL=
